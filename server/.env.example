# Copy to server/.env and fill in.  Көшіріп, server/.env деп атаңыз.

PORT=3000
# Long random string. If empty, one is generated into server/data/.jwt-secret
JWT_SECRET=

# ---------- Email codes (Gmail SMTP) ----------
# Google account → 2-Step Verification → App passwords (myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Campus Hub <you@gmail.com>

# ---------- Email over HTTPS (instead of SMTP) ----------
# For hosts that block SMTP ports (Render free tier). See deploy/mail-relay.gs. Takes priority over SMTP.
MAIL_WEBHOOK_URL=
MAIL_WEBHOOK_SECRET=

# Demo: when email is NOT configured, show the code in the console and on the phone screen.
# Set to false in production so a missing mail setup fails instead of exposing codes.
DEV_SHOW_CODES=true

# Expo web origins allowed to call the API (the phone app itself needs no CORS)
CORS_ORIGINS=http://localhost:8081,http://localhost:8082,http://localhost:19006
